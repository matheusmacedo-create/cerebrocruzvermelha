# ── Apify ────────────────────────────────────────────────────────────────
# Token da conta. Sem ele o Cérebro abre no acervo semente do repositório.
APIFY_TOKEN=

# Key-Value Store onde vive o snapshot do acervo (chave: acervo-atual).
# Crie um store nomeado na Apify e cole o id ou o nome aqui.
APIFY_KV_STORE=

# Actor de coleta do Instagram. O padrão é o oficial da Apify.
APIFY_ACTOR_INSTAGRAM=apify/instagram-post-scraper

# Segredo conferido pelo webhook em /api/webhook/apify?segredo=...
APIFY_WEBHOOK_SECRET=

# ── Vercel ───────────────────────────────────────────────────────────────
# Protege /api/coleta. O Cron da Vercel envia como Bearer.
CRON_SECRET=

# ── Redação (fase 2 do contrato) ─────────────────────────────────────────
# Endereço do app da Redação. Com ele o Cérebro lê /api/cerebro/contexto e
# passa a saber o que a Casa já publicou (ineditismo) e o que o Registrar
# confirma de ação da filial (ação real). Sem ele, decide como sempre decidiu.
REDACAO_URL=https://redacao-cruzvermelhariodejaneiro.vercel.app

# O mesmo segredo do CEREBRO_CONTEXTO_TOKEN da Redação, enviado como Bearer.
# Só é necessário se a Redação tiver fechado a rota de contexto.
REDACAO_CONTEXTO_TOKEN=
